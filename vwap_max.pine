//@version=6
indicator("VWAP MAX", overlay=true)

// Input para definir período de lookback em dias
days_back = input.int(60, "Período de Lookback (dias)", minval=1, maxval=365)

// Calcular número de barras aproximado (depende do timeframe)
bars_in_period = switch timeframe.period
    "1"   => days_back * 390  // 1 min: ~390 barras por dia
    "5"   => days_back * 78   // 5 min: ~78 barras por dia
    "15"  => days_back * 26   // 15 min: ~26 barras por dia
    "60"  => days_back * 6.5  // 1 hora: ~6.5 barras por dia
    "240" => days_back * 1.6  // 4 horas: ~1.6 barras por dia
    "D"   => days_back        // Diário: 1 barra por dia
    => days_back * 6.5        // Padrão para outros timeframes

lookback_bars = math.floor(bars_in_period)

// Encontrar a máxima dos últimos N dias e quando ela ocorreu
var int anchor_bar = na
var float anchor_price = na
var bool anchored = false

// Procurar a máxima nos últimos lookback_bars
highest_value = ta.highest(high, lookback_bars)

// Detectar quando atingimos um novo máximo
if (high == highest_value and not anchored)
    anchor_bar := bar_index
    anchor_price := high
    anchored := true

// Resetar ancoragem se encontrarmos uma máxima maior
if (high > anchor_price and not na(anchor_price))
    anchor_bar := bar_index
    anchor_price := high

// Variáveis para calcular VWAP
var float vwap_sum = 0.0
var float volume_sum = 0.0

// Resetar VWAP quando ancoragem muda
if (not na(anchor_bar) and bar_index == anchor_bar)
    vwap_sum := 0.0
    volume_sum := 0.0

// Calcular VWAP a partir do ponto de ancoragem
if (not na(anchor_bar) and bar_index >= anchor_bar)
    typical_price = hlc3

    if (bar_index == anchor_bar)
        vwap_sum := typical_price * volume
        volume_sum := volume
    else
        vwap_sum := vwap_sum[1] + (typical_price * volume)
        volume_sum := volume_sum[1] + volume

// Calcular valor da VWAP
vwap_value = volume_sum > 0 ? vwap_sum / volume_sum : na

// Plotar a VWAP ancorada
plot(vwap_value, "VWAP Ancorada na Máxima", color=color.blue, linewidth=2)

// Plotar linha horizontal na máxima de ancoragem
plot(anchor_price, "Ponto de Ancoragem (Máxima)", color=color.red, linewidth=1, style=plot.style_cross)
