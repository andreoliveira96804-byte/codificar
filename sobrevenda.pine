//@version=5
indicator("Sobrevenda", overlay=true)

// ============================================
// PARÂMETROS DOS INDICADORES
// ============================================

// Bollinger Bands
bb_length = input.int(20, "Bollinger Bands Length", minval=1)
bb_mult = input.float(2.0, "Bollinger Bands StdDev", minval=0.1)

// RSI
rsi_length = input.int(14, "RSI Length", minval=1)
rsi_threshold = input.float(25, "RSI Threshold", minval=0, maxval=100)

// ATR
atr_length = input.int(14, "ATR Length", minval=1)
atr_multiplier = input.float(5.0, "ATR Multiplier", minval=0.1)
lookback_days = input.int(5, "Lookback Days", minval=1)

// ============================================
// CÁLCULO DOS INDICADORES
// ============================================

// Bollinger Bands
[bb_middle, bb_upper, bb_lower] = ta.bb(close, bb_length, bb_mult)

// RSI
rsi = ta.rsi(close, rsi_length)

// ATR
atr = ta.atr(atr_length)

// Máxima do candle de N dias atrás
high_lookback = high[lookback_days]

// ============================================
// CRITÉRIOS DE ENTRADA PARA COMPRA
// ============================================

// Critério 1: Candle fecha abaixo da banda inferior da Bollinger
criterio1 = close < bb_lower

// Critério 2: RSI abaixo de 25
criterio2 = rsi < rsi_threshold

// Critério 3: Candle fechou abaixo de (máxima de 5 dias atrás - 5x ATR)
threshold_price = high_lookback - (atr * atr_multiplier)
criterio3 = close < threshold_price

// Sinal de compra quando TODOS os 3 critérios são atendidos
buy_signal = criterio1 and criterio2 and criterio3

// ============================================
// VISUALIZAÇÃO
// ============================================

// Plot das Bollinger Bands
plot(bb_upper, "BB Upper", color=color.red, linewidth=1)
plot(bb_middle, "BB Middle", color=color.gray, linewidth=1)
plot(bb_lower, "BB Lower", color=color.green, linewidth=1)

// Preenchimento entre as bandas
fill(plot(bb_upper), plot(bb_lower), color=color.new(color.gray, 90), title="BB Background")

// Plot do threshold de preço (critério 3)
plot(threshold_price, "Threshold Price (High[5] - 5xATR)", color=color.blue, linewidth=2, style=plot.style_stepline)

// Sinais de compra
plotshape(buy_signal, "Buy Signal", style=shape.triangleup, location=location.belowbar, color=color.green, size=size.normal)

// Background colorido quando há sinal
bgcolor(buy_signal ? color.new(color.green, 85) : na, title="Buy Signal Background")

// ============================================
// TABELA DE INFORMAÇÕES
// ============================================

// Criar tabela com informações dos critérios
var table info_table = table.new(position.top_right, 2, 5, border_width=1)

if barstate.islast
    // Cabeçalho
    table.cell(info_table, 0, 0, "Critério", bgcolor=color.gray, text_color=color.white, text_size=size.small)
    table.cell(info_table, 1, 0, "Status", bgcolor=color.gray, text_color=color.white, text_size=size.small)

    // Critério 1
    table.cell(info_table, 0, 1, "1. Close < BB Lower", text_size=size.small)
    table.cell(info_table, 1, 1, criterio1 ? "✓" : "✗",
               bgcolor=criterio1 ? color.new(color.green, 70) : color.new(color.red, 70),
               text_color=color.white, text_size=size.small)

    // Critério 2
    table.cell(info_table, 0, 2, "2. RSI < " + str.tostring(rsi_threshold), text_size=size.small)
    table.cell(info_table, 1, 2, criterio2 ? "✓" : "✗",
               bgcolor=criterio2 ? color.new(color.green, 70) : color.new(color.red, 70),
               text_color=color.white, text_size=size.small)

    // Critério 3
    table.cell(info_table, 0, 3, "3. Close < High[5] - 5xATR", text_size=size.small)
    table.cell(info_table, 1, 3, criterio3 ? "✓" : "✗",
               bgcolor=criterio3 ? color.new(color.green, 70) : color.new(color.red, 70),
               text_color=color.white, text_size=size.small)

    // Sinal final
    table.cell(info_table, 0, 4, "SINAL DE COMPRA", bgcolor=color.gray, text_color=color.white, text_size=size.small)
    table.cell(info_table, 1, 4, buy_signal ? "COMPRAR" : "AGUARDAR",
               bgcolor=buy_signal ? color.new(color.green, 30) : color.new(color.gray, 70),
               text_color=color.white, text_size=size.normal)

// ============================================
// ALERTAS
// ============================================

alertcondition(buy_signal, title="Sinal de Compra - Sobrevenda", message="ATENÇÃO: Todos os 3 critérios de sobrevenda foram atendidos! Considere compra.")
